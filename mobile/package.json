{
  "name": "ecotrack-mobile",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:lan": "node ./scripts/start-lan.js",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "cross-env EXPO_DEBUG=1 expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --platform android --profile preview",
    "assets": "node generate-assets.js",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --config jest.config.js --runInBand",
    "test:watch": "jest --config jest.config.js --watch",
    "demo:check": "node ./scripts/demo-check.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.0",
    "expo": "^50.0.0",
    "expo-camera": "~14.1.0",
    "expo-constants": "~15.4.6",
    "expo-secure-store": "~12.8.1",
    "react": "18.2.0",
    "react-hook-form": "^7.76.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.4",
    "@types/react": "~18.2.45",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">= 18.0.0"
  }
}
