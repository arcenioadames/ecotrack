# ============================================================================
# CONFIGURACION DE API URL - ECOTRACK MOBILE
# ============================================================================
# 
# Copia este archivo a .env y modifica los valores según tu entorno
# 
# PRIORIDAD DE LECTURA (primero que se encuentre):
# 1. EXPO_PUBLIC_API_URL (variable recomendada)
# 2. API_URL (alternativa)
# 3. NODE_ENV + fallbacks internos
#
# ============================================================================
# VALORES RECOMENDADOS POR ESCENARIO
# ============================================================================
#
# ANDROID EMULATOR (desde máquina Windows/Mac/Linux):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# iOS SIMULATOR (desde máquina Mac):
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
#   o
#   EXPO_PUBLIC_API_URL=http://localhost:3000
#
# EXPO GO EN DISPOSITIVO FISICO (mismo WiFi que backend):
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#   (reemplaza 192.168.1.100 con tu IP real del backend en la red local)
#
# EXPO GO TUNNEL (Expo Tunnel - internet pública):
#   EXPO_PUBLIC_API_URL=https://backend-prod.example.com:3000
#   (o la URL pública de tu backend)
#
# APK EN DISPOSITIVO FISICO (internet pública):
#   EXPO_PUBLIC_API_URL=https://backend-prod.example.com:3000
#
# DESARROLLO LOCAL (Node.js):
#   NODE_ENV=development
#   EXPO_PUBLIC_API_URL=http://localhost:3000
#
# ============================================================================

# Ejemplo para desarrollo local con emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Ejemplo para dispositivo físico en red local:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Ejemplo para producción (URL remota):
# EXPO_PUBLIC_API_URL=https://api.ecotrack.com

# Expo Go en teléfono (misma WiFi que el PC): usa la IP local del PC (ipconfig).
# Si NO defines EXPO_PUBLIC_API_URL, app.config.js intentará detectar la IP automáticamente.
# EXPO_PUBLIC_API_URL=http://192.168.1.XXX:3000
#
# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
