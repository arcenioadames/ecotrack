# ============================================================================
# VARIABLES DE ENTORNO - ECOTRACK WEB
# ============================================================================

# API Configuration
VITE_API_URL=http://localhost:3000

# Token Storage Strategy
# Si es 'true', el backend envía el refresh token en cookie HttpOnly
# Si es 'false', el refresh token se devuelve en la respuesta y se guarda en localStorage
VITE_REFRESH_TOKEN_COOKIE=false

# Development Server
VITE_PORT=5173

# Features
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_AUDIT_LOGS=true
