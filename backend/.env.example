# ===================================================================
# SUPABASE POSTGRESQL CONFIGURATION
# ===================================================================
# DATABASE_URL: PgBouncer conexión (puerto 6543, pooling habilitado)
# DIRECT_URL: Conexión directa (puerto 5432) para migraciones/introspections
# 
# Para obtener estas URLs:
# 1. Accede al dashboard de Supabase
# 2. Navega a Settings > Database
# 3. Copia la "Connection String" (CONNECTION_POOLING)
# 4. Copia la "Connection String" (SESSION) para DIRECT_URL
# 5. Reemplaza [YOUR-PASSWORD] con tu password de Supabase
#
# SSL MODE: Supabase requiere ?sslmode=require (PgBouncer + directUrl)
# IMPORTANTE: NO commitees este archivo con passwords reales.
# ===================================================================

DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ===================================================================
# PARA DESARROLLO LOCAL CON POSTGRESQL (alternativa a Supabase)
# ===================================================================
# Si usas PostgreSQL local en lugar de Supabase, comenta las líneas superiores
# y descomenta estas (puedes usar la misma URL en ambas sin pooler):
#
# DATABASE_URL="postgresql://user:password@localhost:5432/ecotrack"
# DIRECT_URL="postgresql://user:password@localhost:5432/ecotrack"

# ===================================================================
# APPLICATION CONFIGURATION
# ===================================================================

PORT=3000
NODE_ENV=development

# ===================================================================
# SECURITY & JWT
# ===================================================================
# IMPORTANTE: En producción, usa valores seguros y únicos.
# En CI/CD, configura estas variables en GitHub Actions / Supabase secrets.
# NO commitees passwords o secrets aquí.

ACCESS_TOKEN_SECRET=change_me_in_production
REFRESH_TOKEN_SECRET=change_me_in_production

# ===================================================================
# APPLICATION SETTINGS
# ===================================================================

BCRYPT_SALT_ROUNDS=12
POLICY_VERSION=1
CORS_ORIGIN=http://localhost:5173

# ===================================================================
# OPTIONAL: INTEGRATION TESTING AGAINST SUPABASE PROJECT
# ===================================================================
# Si tienes un proyecto Supabase dedicado para testing remoto:
# ECOTRACK_INTEGRATION_REMOTE_DB=1
